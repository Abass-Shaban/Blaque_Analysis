# ---------------------------------------------------------------- general
APP_NAME=BLAQUE ANALYSIS
ENVIRONMENT=development
DEBUG=false

# Generate a strong value for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-6f1c0b8f0f5a4f4e9a3d2c1b7e8f9a0c
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma separated list of allowed browser origins
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional bootstrap administrator (created/promoted on first sync or CLI run)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --------------------------------------------------------------- database
# SQLite (default, zero-config):
DATABASE_URL=sqlite:///data/blaque.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://blaque:blaque@localhost:5432/blaque
DB_ECHO=false

# --------------------------------------------------------------- provider
PROVIDER=espn
HTTP_TIMEOUT=25
HTTP_RETRIES=3
HTTP_CONCURRENCY=6
FEATURED_LEAGUES=eng.1,esp.1,ita.1,ger.1,fra.1,uefa.champions,uefa.europa,usa.1,ned.1,por.1,tur.1,bra.1

# ------------------------------------------------------------------ cache
CACHE_TTL_LIVE=45
CACHE_TTL_FIXTURES=300
CACHE_TTL_STANDINGS=21600
CACHE_TTL_SUMMARY=3600
CACHE_TTL_SCHEDULE=21600
CACHE_TTL_TEAMS=86400

# ------------------------------------------------------------------- sync
# Warm the database from ESPN in the background when the server boots.
SYNC_ON_STARTUP=true
SYNC_MONTHS_BACK=1
SYNC_MONTHS_AHEAD=1

# In-process daily refresh. Set ENABLED=false on hosts that sleep when idle
# and trigger `python -m backend.app.cli sync` from cron/Task Scheduler instead.
DAILY_SYNC_ENABLED=true
DAILY_SYNC_HOUR_UTC=3
DAILY_SYNC_MINUTE_UTC=0

# ------------------------------------------------------------------ model
MODEL_BLEND_WEIGHT=0.35
MODEL_MIN_SAMPLES=180

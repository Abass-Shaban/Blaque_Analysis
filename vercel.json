{
  "version": 2,
  "rewrites": [
    {
      "source": "/(assets|css|js|vendor)/(.*)",
      "destination": "/frontend/$1/$2"
    },
    {
      "source": "/favicon.ico",
      "destination": "/frontend/assets/favicon.svg"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/redoc",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "0 3 * * *"
    }
  ]
}
